rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for data integrity & validation
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'emprendimientogregoryizquierdo@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Users Collection (Firebase Auth Profiles & Roles) ---
    match /users/{userId} {
      allow read: if true;
      // Default role on creation must be 'cliente'
      allow create: if hasRequiredFields(['uid', 'email', 'role']) && 
                    request.resource.data.role == 'cliente';
      // Only admin can change role; users can only update other fields preserving role
      allow update: if (request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'name']) && 
                            request.resource.data.id is string && 
                            request.resource.data.name is string;
      allow delete: if true;
    }

    // --- Payment Methods Collection ---
    match /payment_methods/{methodId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'name']) &&
                            request.resource.data.id is string;
      allow delete: if true;
    }

    // --- Customers Collection ---
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'name']) &&
                            request.resource.data.id is string &&
                            request.resource.data.name is string;
      allow delete: if true;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'total', 'status']) &&
                            request.resource.data.id is string &&
                            request.resource.data.total is number;
      allow delete: if true;
    }

    // --- Wallet Topups Collection ---
    match /wallet_topups/{topupId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'status']) &&
                            request.resource.data.id is string;
      allow delete: if true;
    }

    // --- Incidents Collection ---
    match /incidents/{incidentId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'status']) &&
                            request.resource.data.id is string;
      allow delete: if true;
    }

    // --- Global Configuration (Branding, BCV Rate, FAQ) ---
    match /config/{configDocId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Operational & Financial Collections ---
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /franchises/{franchiseId} {
      allow read, write: if true;
    }

    match /purchases/{purchaseId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    // --- Franchise Applications (Public Form) ---
    match /franchise_applications/{applicationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // --- Franchise Tickets (Support) ---
    match /franchise_tickets/{ticketId} {
      allow read, write: if true; // Keeping it simple for now as per project style
    }
  }
}
